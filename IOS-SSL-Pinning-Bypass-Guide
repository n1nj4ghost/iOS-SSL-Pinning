### Method C — Targeted Frida Hooks

**Run on host:**
```bash
frida -U -f com.example.app -l bypass.js --no-pause
```

**Combine these patterns** — they don't conflict:

#### C.1 — Generic Apple ObjC + Sec* Trust APIs

```javascript
// bypass.js — generic iOS trust bypass
if (ObjC.available) {
  try {
    // NSURLSession delegate: handles ~60% of modern Swift/ObjC apps
    var resolver = new ApiResolver('objc');
    resolver.enumerateMatches(
      '-[* URLSession:didReceiveChallenge:completionHandler:]',
      {
        onMatch: function (m) {
          Interceptor.attach(m.address, {
            onEnter: function (args) {
              this.challenge = new ObjC.Object(args[3]);
              this.handler = new ObjC.Block(args[4]);
            },
            onLeave: function () {
              try {
                var protSpace = this.challenge.protectionSpace();
                var trust = protSpace.serverTrust();
                if (trust && !trust.isNull()) {
                  var cred = ObjC.classes.NSURLCredential.credentialForTrust_(trust);
                  // NSURLSessionAuthChallengeUseCredential = 0
                  this.handler.implementation(0, cred);
                }
              } catch (e) { console.log('[NSURLSession] ' + e); }
            }
          });
        },
        onComplete: function () {}
      }
    );
  } catch (e) { console.log('[!] NSURLSession hook failed: ' + e); }

  // SecTrustEvaluate — catches Cronet, custom CFNetwork, some Swift stacks
  var SecTrustEvaluate = Module.findExportByName(null, 'SecTrustEvaluate');
  if (SecTrustEvaluate) {
    Interceptor.replace(SecTrustEvaluate, new NativeCallback(
      function (trust, resultPtr) {
        Memory.writeU32(resultPtr, 1); // kSecTrustResultProceed = 1
        return 0; // errSecSuccess
      },
      'int',
      ['pointer', 'pointer']
    ));
  }

  // SecTrustEvaluateWithError
  var SecTrustEvaluateWithError = Module.findExportByName(null, 'SecTrustEvaluateWithError');
  if (SecTrustEvaluateWithError) {
    Interceptor.replace(SecTrustEvaluateWithError, new NativeCallback(
      function (trust, errorPtr) {
        if (!errorPtr.isNull()) Memory.writePointer(errorPtr, NULL);
        return 1; // true => trusted
      },
      'bool',
      ['pointer', 'pointer']
    ));
  }
}
```

#### C.2 — TrustKit

```javascript
if (ObjC.available && ObjC.classes.TSKPinningValidator) {
  var V = ObjC.classes.TSKPinningValidator;
  
  // Legacy API
  if (V['- evaluateTrust:forHostname:']) {
    V['- evaluateTrust:forHostname:'].implementation = function () {
      return 0; // TSKTrustEvaluationSuccess = 0
    };
  }
  
  // Newer TrustKit API
  if (V['- handleChallenge:forHostname:completionHandler:']) {
    V['- handleChallenge:forHostname:completionHandler:'].implementation =
      function (challenge, hostname, completion) {
        var cred = ObjC.classes.NSURLCredential
          .credentialForTrust_(challenge.protectionSpace().serverTrust());
        new ObjC.Block(completion).implementation(0, cred);
        return true;
      };
  }
}
```

#### C.3 — AFNetworking (when SSL Kill Switch isn't installed)

```javascript
if (ObjC.available && ObjC.classes.AFSecurityPolicy) {
  var P = ObjC.classes.AFSecurityPolicy;
  P['- evaluateServerTrust:forDomain:'].implementation = function () { return true; };
  P['- setSSLPinningMode:'].implementation = function () { /* swallow */ };
  P['- setAllowInvalidCertificates:'].implementation = function () { /* swallow */ };
}
```

#### C.4 — Alamofire (Swift)

```javascript
// Alamofire's PublicKeysTrustEvaluator is hard to hook by mangled symbol.
// Primary defense: rely on C.1 to catch SecTrust* calls.
// Fallback: search for and disable Alamofire's evaluator:

var alamo = Process.findModuleByName('Alamofire');
if (alamo) {
  alamo.enumerateSymbols().forEach(function (s) {
    if (/TrustEvaluator.*evaluate/.test(s.name)) {
      try {
        Interceptor.replace(s.address, new NativeCallback(
          function () { return 1; }, // succeed
          'bool',
          ['pointer', 'pointer', 'pointer']
        ));
      } catch (e) { console.log('[Alamofire] Symbol replacement failed'); }
    }
  });
}
```

#### C.5 — Flutter (libflutter.dylib)

Flutter ships its own BoringSSL and ignores the system trust store. Target: `ssl_crypto_x509_session_verify_cert_chain`.

> **Note**: Offset shifts per Flutter release. Use pattern matching, not symbols (stripped in release builds).

**Pragmatic approach**: Use pre-built Flutter bypass script:
```bash
# https://github.com/Tonyzzx/flutter-ssl-bypass-frida
# 1. Identify Flutter version: strings libflutter.so | grep 'Flutter Engine'
# 2. Look up offset in bypass repo's table
# 3. Paste offset into Frida script and run
```

#### C.6 — Cronet / Chromium Net Stack

If you see `cronet_*` symbols, the app bundles Chromium's BoringSSL (not system TLS).

**Approach**:
1. Hook `SSL_VERIFY_X509_callback` entry points, OR
2. Use `frida-cronet-bypass`, OR
3. Hook `Cronet_UrlRequest_*Verify*` at the Cronet-level delegate

